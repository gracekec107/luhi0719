<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>GitHub 스타일 인증</title>
  <style>
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      background-color: #0d1117;
      color: #f0f6fc;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }
    .auth-container {
      width: 320px;
    }
    .logo {
      text-align: center;
      margin-bottom: 24px;
    }
    .logo svg {
      width: 48px;
      height: 48px;
      fill: #f0f6fc;
    }
    .tabs {
      display: flex;
      margin-bottom: 16px;
      border-bottom: 1px solid #30363d;
    }
    .tab-btn {
      flex: 1;
      padding: 10px;
      background: none;
      border: none;
      color: #8b949e;
      font-weight: 600;
      cursor: pointer;
      font-size: 14px;
      border-bottom: 2px solid transparent;
    }
    .tab-btn.active {
      color: #f0f6fc;
      border-bottom-color: #2f81f7;
    }
    .auth-box {
      background-color: #161b22;
      border: 1px solid #30363d;
      border-radius: 6px;
      padding: 20px;
    }
    .form-group {
      margin-bottom: 16px;
    }
    label {
      display: block;
      font-size: 14px;
      margin-bottom: 8px;
      font-weight: 500;
    }
    input {
      width: 100%;
      box-sizing: border-box;
      padding: 8px 12px;
      font-size: 14px;
      background-color: #0d1117;
      border: 1px solid #30363d;
      border-radius: 6px;
      color: #f0f6fc;
      outline: none;
    }
    input:focus {
      border-color: #2f81f7;
      box-shadow: 0 0 0 3px rgba(47, 129, 247, 0.3);
    }
    .btn-submit {
      width: 100%;
      padding: 9px 16px;
      font-size: 14px;
      font-weight: 600;
      color: #ffffff;
      background-color: #238636; /* 가입은 초록색 계열, 로그인도 파란색 커스텀 가능 */
      border: 1px solid rgba(240, 246, 252, 0.1);
      border-radius: 6px;
      cursor: pointer;
    }
    .btn-submit.login-mode {
      background-color: #2f81f7;
    }
    .btn-submit:hover {
      opacity: 0.9;
    }
    .msg {
      margin-top: 12px;
      font-size: 13px;
      text-align: center;
      min-height: 20px;
    }
    .msg.error { color: #f85149; }
    .msg.success { color: #3fb950; }
  </style>
</head>
<body>
  <div class="auth-container">
    <div class="logo">
      <svg height="48" viewBox="0 0 16 16" width="48">
        <path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A8.013 8.013 0 0 1 0 8c0-4.42 3.58-8 8-8Z"></path>
      </svg>
    </div>
    
    <div class="tabs">
      <button class="tab-btn active" id="tab-login" onclick="switchTab('login')">로그인</button>
      <button class="tab-btn" id="tab-signup" onclick="switchTab('signup')">회원가입</button>
    </div>

    <div class="auth-box">
      <form id="auth-form" onsubmit="handleSubmit(event)">
        <div class="form-group">
          <label for="email">이메일 주소</label>
          <input type="email" id="email" placeholder="name@example.com" required>
        </div>
        <div class="form-group">
          <label for="password">비밀번호</label>
          <input type="password" id="password" placeholder="비밀번호를 입력하세요" required>
        </div>
        <button type="submit" id="submit-btn" class="btn-submit login-mode">로그인</button>
      </form>
      <div id="msg" class="msg"></div>
    </div>
  </div>

  <script>
    let currentMode = 'login'; // 'login' or 'signup'

    function switchTab(mode) {
      currentMode = mode;
      const loginTab = document.getElementById('tab-login');
      const signupTab = document.getElementById('tab-signup');
      const submitBtn = document.getElementById('submit-btn');
      const msg = document.getElementById('msg');
      msg.textContent = '';

      if (mode === 'login') {
        loginTab.classList.add('active');
        signupTab.classList.remove('active');
        submitBtn.textContent = '로그인';
        submitBtn.className = 'btn-submit login-mode';
      } else {
        signupTab.classList.add('active');
        loginTab.classList.remove('active');
        submitBtn.textContent = '회원가입하기';
        submitBtn.className = 'btn-submit';
      }
    }

    function handleSubmit(e) {
      e.preventDefault();
      const email = document.getElementById('email').value.trim();
      const password = document.getElementById('password').value;
      const msg = document.getElementById('msg');

      // 저장소에서 기존 회원 목록 불러오기
      let users = JSON.parse(localStorage.getItem('vibe_users') || '{}');

      if (currentMode === 'signup') {
        if (users[email]) {
          msg.className = 'msg error';
          msg.textContent = '이미 등록된 이메일입니다.';
          return;
        }
        users[email] = { password, createdAt: new Date().toISOString() };
        localStorage.setItem('vibe_users', JSON.stringify(users));
        
        msg.className = 'msg success';
        msg.textContent = '회원가입 완료! 로그인해 주세요.';
        setTimeout(() => switchTab('login'), 1500);
      } else {
        if (!users[email] || users[email].password !== password) {
          msg.className = 'msg error';
          msg.textContent = '이메일 또는 비밀번호가 올바르지 않습니다.';
          return;
        }
        msg.className = 'msg success';
        msg.textContent = `환영합니다, ${email}님!`;
      }
    }
  </script>
</body>
</html>
